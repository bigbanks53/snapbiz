# Copy this file to `.env` for local development and fill in your Supabase values.
# In production, set the same variables in Vercel → Project Settings → Environment Variables.
#
# Both values are the public, publishable (browser) credentials for your Supabase
# project — they are safe to ship in the client bundle; data access is governed
# by your database's Row Level Security (RLS) policies.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (starts with sb_publishable_...), found under
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_PUBLISHABLE_KEY=
